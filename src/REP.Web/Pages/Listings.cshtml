@page
@model ListingsModel
@{
    ViewData["Title"] = "Listings";
}

<h1>Listings</h1>

@if (Model.Listings.Count == 0)
{
    <div class="alert alert-info">No listings found.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var listing in Model.Listings)
        {
            <div class="col">
                <a asp-page="/Listing" asp-route-id="@listing.Id" class="text-decoration-none text-reset">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">@listing.Title</h5>
                            <p class="card-text">@listing.Description</p>
                            <small class="text-muted">Listed by @listing.User.Name</small>
                        </div>
                        <div class="card-footer d-flex justify-content-between align-items-center">
                            @if (listing.Price is not null)
                            {
                                <span class="fw-bold text-success">@listing.Price.Amount.ToString("N2") @listing.Price.Currency</span>
                            }
                            else
                            {
                                <span class="text-muted">Price on request</span>
                            }
                            <small class="text-muted">@listing.CreatedAt.ToString("dd MMM yyyy")</small>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}
